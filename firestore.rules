rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Personal del complejo: memberships/{uid del usuario} dice a qué complejo pertenece y con qué rol
    function staffRole(uid) {
      let m = get(/databases/$(database)/documents/memberships/$(request.auth.uid));
      return m != null && m.data.tenantId == uid ? m.data.role : '';
    }
    function isStaff(uid, roles) {
      return signedIn() && staffRole(uid) in roles;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // Administración de la plataforma (panel de clientes): solo esta cuenta, con el mail verificado
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'piccini.gabriela@gmail.com';
    }

    // Notas de limpieza: la lista nueva tiene todas las anteriores más una sola nota, de Limpieza y con texto corto
    function limpiezaAddsOneNote() {
      let before = resource.data.get('messages', []);
      let after = request.resource.data.messages;
      return after is list
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && after[after.size() - 1].keys().hasOnly(['by', 'name', 'text', 'at'])
        && after[after.size() - 1].by == 'limpieza'
        && after[after.size() - 1].text is string
        && after[after.size() - 1].text.size() > 0
        && after[after.size() - 1].text.size() <= 500
        && after[after.size() - 1].name is string
        && after[after.size() - 1].name.size() <= 60;
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /tenants/{uid} {
      // Limpieza no lee este documento (tarifas, comisión, teléfonos del equipo, plantillas):
      // el nombre del complejo y los horarios le llegan por staff/complejo
      allow read: if isOwner(uid) || isStaff(uid, ['recepcion']) || isAdmin();
      allow write: if isOwner(uid);

      match /properties/{docId} {
        allow read: if isOwner(uid) || isStaff(uid, ['recepcion', 'limpieza']);
      }
      match /reservations/{docId} {
        allow read, write: if isStaff(uid, ['recepcion']);
      }
      match /cashMovements/{docId} {
        allow read, write: if isStaff(uid, ['recepcion']);
      }
      match /reminders/{docId} {
        allow read, write: if isStaff(uid, ['recepcion']);
      }
      match /cleaningTasks/{docId} {
        allow read: if isStaff(uid, ['recepcion', 'limpieza']);
        allow create, delete: if isStaff(uid, ['recepcion']);
        // Limpieza marca el checklist y el estado, y puede sumar una nota suya (sin tocar las demás)
        allow update: if isStaff(uid, ['recepcion'])
          || (isStaff(uid, ['limpieza'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist', 'status', 'messages'])
              && (!('messages' in request.resource.data.diff(resource.data).affectedKeys()) || limpiezaAddsOneNote()));
      }
      match /sync/{docId} {
        allow read: if isStaff(uid, ['recepcion']);
      }
      // Para Limpieza, sin datos sensibles: staff/llegadas (próximos ingresos, sin teléfonos ni importes)
      // y staff/complejo (nombre del complejo, horarios de check-in y check-out, fecha de alta)
      match /staff/{docId} {
        allow read: if isStaff(uid, ['recepcion', 'limpieza']);
        allow write: if isStaff(uid, ['recepcion']);
      }
      // El dueño puede todo en sus subcolecciones
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isStaff(uid, ['recepcion', 'limpieza']) || isAdmin();
      // Solo la administración activa, renueva o suspende, deja una nota o habilita diseños especiales de Tu Web; nadie más escribe acá.
      // En una actualización se mira solo lo que cambia, así un documento cargado a mano con otros campos no la traba.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'plan', 'activeUntil', 'note', 'webDesigns', 'updatedAt'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'suspended'])
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['propietario', 'complejo'])
        && (!('webDesigns' in request.resource.data) || (request.resource.data.webDesigns is list && request.resource.data.webDesigns.size() <= 10));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'plan', 'activeUntil', 'note', 'webDesigns', 'updatedAt'])
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.status in ['active', 'suspended'])
        && (!('plan' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.plan in ['propietario', 'complejo'])
        && (!('webDesigns' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.webDesigns is list && request.resource.data.webDesigns.size() <= 10));
    }

    // Cobro del abono de Loomi: precios, datos de transferencia y Payoneer, días de gracia.
    // La leen los usuarios con sesión (en "Mi plan"); la edita solo la administración.
    match /config/billing {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // "Ya pagué": el cliente avisa (solo a su nombre, una vez por aviso); la administración lo ve y lo archiva.
    match /paymentNotices/{noticeId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'complexName', 'email', 'plan', 'method', 'amount', 'currency', 'rate', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.plan in ['propietario', 'complejo']
        && request.resource.data.method in ['transferencia', 'payoneer']
        && request.resource.data.currency in ['ARS', 'USD']
        && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount < 100000000
        && request.resource.data.rate is number
        && request.resource.data.complexName is string && request.resource.data.complexName.size() < 120
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
      allow delete: if isAdmin();
    }

    // Invitaciones: el id es el mail en minúsculas. Las crea el dueño; las lee y acepta (o rechaza) la persona invitada.
    match /invites/{email} {
      allow get: if signedIn() && (myEmail() == email || resource.data.tenantId == request.auth.uid);
      allow list: if signedIn() && resource.data.tenantId == request.auth.uid;
      allow create: if signedIn()
        && email == email.lower()
        && myEmail() != email
        && request.resource.data.keys().hasOnly(['email', 'tenantId', 'role', 'complexName', 'invitedAt'])
        && request.resource.data.email == email
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.role in ['recepcion', 'limpieza']
        && request.resource.data.complexName is string
        && request.resource.data.complexName.size() < 120;
      allow update: if signedIn()
        && resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'tenantId', 'role', 'complexName', 'invitedAt'])
        && request.resource.data.email == email
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.role in ['recepcion', 'limpieza']
        && request.resource.data.complexName is string
        && request.resource.data.complexName.size() < 120;
      allow delete: if signedIn() && (myEmail() == email || resource.data.tenantId == request.auth.uid);
    }

    // Accesos del personal: se crean solo al aceptar una invitación válida (con el mail confirmado).
    // El dueño los ve y los borra para quitar el acceso; la persona puede borrar el suyo.
    match /memberships/{memberUid} {
      function myInvite() {
        return get(/databases/$(database)/documents/invites/$(myEmail())).data;
      }
      allow get: if signedIn() && (request.auth.uid == memberUid || resource.data.tenantId == request.auth.uid);
      allow list: if signedIn() && resource.data.tenantId == request.auth.uid;
      allow create: if signedIn()
        && request.auth.uid == memberUid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['tenantId', 'role', 'email', 'name', 'complexName', 'joinedAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.tenantId != request.auth.uid
        && request.resource.data.tenantId == myInvite().tenantId
        && request.resource.data.role == myInvite().role
        && request.resource.data.complexName == myInvite().complexName
        && request.resource.data.name is string
        && request.resource.data.name.size() < 120;
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == memberUid || resource.data.tenantId == request.auth.uid);
    }

    match /publicGuides/{uid} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(uid);
    }
    match /publicCalendars/{uid}/units/{unitId} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(uid) || isStaff(uid, ['recepcion']);
    }
    // Tu Web. El link usa un nombre (slug), no el uid: así nadie llega a la guía (wifi, accesos) desde la página pública.
    // siteOwners/{slug}: de quién es cada nombre (privado). El primero que lo crea, lo tiene.
    function siteOwner(slug) {
      return get(/databases/$(database)/documents/siteOwners/$(slug)).data.uid;
    }
    function isSiteOwner(slug) {
      return signedIn() && exists(/databases/$(database)/documents/siteOwners/$(slug)) && siteOwner(slug) == request.auth.uid;
    }
    match /siteOwners/{slug} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isStaff(resource.data.uid, ['recepcion']));
      allow list: if false;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // publicSites/{slug}: la página pública (nombre, fotos, unidades, tarifas y fechas ocupadas, sin datos de huéspedes)
    match /publicSites/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if isSiteOwner(slug);
      // El dueño cambia todo; Recepción solo las fechas ocupadas (cuando carga una reserva)
      allow update: if isSiteOwner(slug)
        || (signedIn()
            && exists(/databases/$(database)/documents/siteOwners/$(slug))
            && isStaff(siteOwner(slug), ['recepcion'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['busy', 'busyUpdatedAt']));
      match /photos/{photoId} {
        allow read: if true;
        allow create, update: if isSiteOwner(slug)
          && request.resource.data.keys().hasOnly(['data', 'order', 'unitId'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
          && request.resource.data.data.size() < 950000
          && request.resource.data.order is number
          && request.resource.data.unitId is string && request.resource.data.unitId.size() < 200;
        allow delete: if isSiteOwner(slug);
      }
    }
    // Dominio propio → nombre del link. Lo carga la administración de Loomi al dar de alta el dominio.
    match /siteDomains/{host} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Pre check-in del huésped: cualquiera puede crearlo (una sola vez, con datos validados)
    // si el anfitrión tiene guía publicada; solo el anfitrión (o su Recepción) lo lee, corrige o borra.
    match /precheckins/{hostUid}/items/{itemId} {
      allow create: if exists(/databases/$(database)/documents/publicGuides/$(hostUid))
        && request.resource.data.keys().hasOnly(['reservationId', 'fullName', 'docType', 'docNumber', 'nationality', 'guests', 'arrivalTime', 'phone', 'companions', 'comments', 'acceptedRules', 'lang', 'submittedAt'])
        && request.resource.data.reservationId is string && request.resource.data.reservationId.size() > 0 && request.resource.data.reservationId.size() < 300
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 1 && request.resource.data.fullName.size() < 120
        && request.resource.data.docType in ['dni', 'pasaporte', 'otro']
        && request.resource.data.docNumber is string && request.resource.data.docNumber.size() > 2 && request.resource.data.docNumber.size() < 40
        && request.resource.data.nationality is string && request.resource.data.nationality.size() < 60
        && request.resource.data.guests is int && request.resource.data.guests >= 1 && request.resource.data.guests <= 30
        && request.resource.data.arrivalTime is string && request.resource.data.arrivalTime.size() < 40
        && request.resource.data.phone is string && request.resource.data.phone.size() < 40
        && request.resource.data.companions is string && request.resource.data.companions.size() < 600
        && request.resource.data.comments is string && request.resource.data.comments.size() < 1000
        && request.resource.data.lang is string && request.resource.data.lang.size() < 6
        && request.resource.data.acceptedRules == true
        && request.resource.data.submittedAt == request.time;
      allow read, update, delete: if isOwner(hostUid) || isStaff(hostUid, ['recepcion']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
