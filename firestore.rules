rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Colección de leads y contactos comerciales: solo creación (write-only / create-only).
    // Bloqueada totalmente para lectura, actualización o borrado público.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Colección de complejos de Loomi Suite: protegida contra lectura/escritura pública abierta
    match /complexes/{complexId} {
      allow read, write: if request.auth != null;
      
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Registro de cuentas y credenciales: blindado totalmente contra lectura y escritura abierta
    match /registered_complexes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}

