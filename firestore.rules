rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /tenants/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /publicGuides/{uid} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /publicCalendars/{uid}/units/{unitId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Pre check-in del huésped: cualquiera puede crearlo (una sola vez, con datos validados)
    // si el anfitrión tiene guía publicada; solo el anfitrión lo lee, corrige o borra.
    match /precheckins/{hostUid}/items/{itemId} {
      allow create: if exists(/databases/$(database)/documents/publicGuides/$(hostUid))
        && request.resource.data.keys().hasOnly(['reservationId', 'fullName', 'docType', 'docNumber', 'nationality', 'guests', 'arrivalTime', 'phone', 'companions', 'comments', 'acceptedRules', 'lang', 'submittedAt'])
        && request.resource.data.reservationId is string && request.resource.data.reservationId.size() > 0 && request.resource.data.reservationId.size() < 300
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 1 && request.resource.data.fullName.size() < 120
        && request.resource.data.docType in ['dni', 'pasaporte', 'otro']
        && request.resource.data.docNumber is string && request.resource.data.docNumber.size() > 2 && request.resource.data.docNumber.size() < 40
        && request.resource.data.nationality is string && request.resource.data.nationality.size() < 60
        && request.resource.data.guests is int && request.resource.data.guests >= 1 && request.resource.data.guests <= 30
        && request.resource.data.arrivalTime is string && request.resource.data.arrivalTime.size() < 40
        && request.resource.data.phone is string && request.resource.data.phone.size() < 40
        && request.resource.data.companions is string && request.resource.data.companions.size() < 600
        && request.resource.data.comments is string && request.resource.data.comments.size() < 1000
        && request.resource.data.lang is string && request.resource.data.lang.size() < 6
        && request.resource.data.acceptedRules == true
        && request.resource.data.submittedAt == request.time;
      allow read, update, delete: if request.auth != null && request.auth.uid == hostUid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


